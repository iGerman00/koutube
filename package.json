{
  "name": "yockstube",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "start": "wrangler dev --remote",
    "init-db": "wrangler d1 execute koutube-db --local --file=./schema.sql",
    "init-remote-db": "wrangler d1 execute koutube-db --remote --file=./schema.sql",
    "drop-images": "wrangler d1 execute koutube-db --remote --file=./drop_image_cache.sql",
    "drop-last-1d": "wrangler d1 execute koutube-db --remote --file=./drop_last_1d.sql"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "he": "^1.2.0"
  }
}
